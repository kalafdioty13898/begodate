# ----- بگودیت: نمونه فایل محیطی -----
# این فایل را با نام .env کپی کن و مقادیر واقعی را بگذار.
# هرگز .env را در گیت کامیت نکن (در .gitignore است).

# توکن ربات که از @BotFather می‌گیری
BOT_TOKEN=1234567890:AAAA-your-real-token-here

# آیدی عددی ادمین (از @userinfobot یا @my_id_bot بگیر)
ADMIN_ID=123456789

# نام کاربری ربات بدون @ (اختیاری؛ در اجرا خودکار از getMe پر می‌شود)
# BOT_USERNAME=BagooditBot

# ----- اختیاری -----
# DB_PATH=/var/lib/bagoodit/bagoodit.db
# LOG_LEVEL=INFO   (DEBUG / INFO / WARNING / ERROR / CRITICAL)

# Snapshot JSON (پشتیبان‌گیری/بازیابی — برای هفته‌ی اول روی GitHub Actions)
# SNAPSHOT_PATH=/var/lib/bagoodit/snapshot.json
# SNAPSHOT_ENABLED=true   (false = غیرفعال)

# TEST_MODE_ENABLED=true
# TEST_MODE_DAYS=7
# TEST_USERS_PER_CITY_F=20
# TEST_USERS_PER_CITY_M=17
# TEST_USER_MAX_REPLIES=10
# TEST_REPLY_MIN_DELAY=3
# TEST_REPLY_MAX_DELAY=10
# REAL_USERS_FIRST=true
# WELCOME_COINS=5
# REFERRAL_REWARD=10
# MATCH_COOLDOWN_MIN=720
